# Smart Clinic Management System - Environment Variables

# Server Configuration
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_clinic_db
DB_USERNAME=postgres
DB_PASSWORD=tukaram

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-this-in-production-with-a-strong-key-at-least-256-bits-long
JWT_EXPIRATION=86400000

# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Environment
APP_ENV=development

